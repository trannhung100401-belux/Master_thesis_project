```{r}
#This script is used to analyze the results of flow cytometry data in Experiment 3 under different concentrations of Lawsone, Lawsone with fumarate, menaquinone-7, menaquinone-7 with fumarate
```

```{r}
library(tidyverse)
library(writexl)
library(readxl)
library(ggplot2)

df <- read_excel("FC_BH_Law_corrected.xlsx")
OUTPUT_DIR <- "BH_Exp3"
```

```{r}
df <- df %>%
  mutate(
    Replicate = str_extract(Tube_name, "BH\\d"),
    Time = factor(Time, levels = c("T0", "T24", "T48")),
    Concentration = factor(
      Concentration,
      levels = c("Control", "0.625uM", "2.5uM", "5uM", "10uM")
    )
  )
```

```{r}
# Exclude YCFAG entirely - only compare Concentration vs Control within the
# other medium (Sample_ID == "Law", i.e. WC4). Everything downstream
# (summary tables, all plots, the mixed model) now only reflects this subset.
df <- df %>%
  filter(Sample_ID != "YCFAG")
```

```{r}
summary_df <- df %>%
  group_by(Sample_ID, Concentration, Time) %>%
  summarise(
    mean_cells = mean(corrected_Cell_size_EventsPer_μL_V_dil, na.rm = TRUE),
    sd_cells   = sd(corrected_Cell_size_EventsPer_μL_V_dil, na.rm = TRUE),
    .groups = "drop"
  )
```

```{r}
# Mixed model + violin plot with p-values
# Replicate is treated as a random effect 
# Concentration and Time are fixed effects
# lmer() fits the coefficients;
# emmeans() then computes, separately at each time point, whether cell
# concentration changes significantly as Concentration increases - via a
# "poly" contrast, which tests for a linear trend across the ordered
# Concentration levels (Control < 0.625uM < 2.5uM < 5uM < 10uM).

library(lme4)
library(lmerTest)   # adds Satterthwaite p-values to lmer's anova()
library(emmeans)    # marginal means + contrasts, using Kenward-Roger df

df <- df %>%
  mutate(
    Concentration = factor(Concentration,
                            levels = c("Control","0.625uM","2.5uM","5uM","10uM"),
                            ordered = TRUE),
    # unique random-effect grouping: a given Replicate ID (e.g. "BH1") is only
    # the same physical unit WITHIN one Concentration - "BH1" under Control and
    # "BH1" under 10uM are different flasks, so pool by their combination
    unit = interaction(Concentration, Replicate, drop = TRUE),
    logCells = log10(corrected_Cell_size_EventsPer_μL_V_dil)
  )

mixed_model <- lmer(logCells ~ Concentration * Time + (1 | unit), data = df)

anova(mixed_model)   # overall test: does Concentration/Time/interaction matter?

# linear trend across Concentration, computed separately at each Time point
contrast_results <- emmeans(mixed_model, "Concentration", by = "Time") |>
  contrast("poly")
print(contrast_results)

contrast_df <- as.data.frame(contrast_results) %>%
  filter(contrast == "linear")   # keep only the linear ("dose-response") trend

stars <- function(p) {
  if (p < 0.001) return("***")
  if (p < 0.01)  return("**")
  if (p < 0.05)  return("*")
  return("ns")
}
contrast_df$sig <- sapply(contrast_df$p.value, stars)
contrast_df$label <- ifelse(
  contrast_df$p.value < 0.0001,
  paste0(contrast_df$sig, "\np < 0.0001"),
  paste0(contrast_df$sig, "\np = ", signif(contrast_df$p.value, 2))
)

# y-position for the annotation bracket: just above the tallest point per facet
ann_y <- df %>%
  group_by(Time) %>%
  summarise(y = max(corrected_Cell_size_EventsPer_μL_V_dil, na.rm = TRUE) * 1.15)
contrast_df <- left_join(contrast_df, ann_y, by = "Time")

n_conc <- nlevels(df$Concentration)

violin_pvalue_plot <- ggplot(df, aes(x = Concentration,
                                      y = corrected_Cell_size_EventsPer_μL_V_dil,
                                      fill = Concentration)) +
  geom_violin(trim = FALSE, alpha = 0.4, scale = "width", color = NA) +
  geom_jitter(width = 0.08, size = 1.5, alpha = 0.7, color = "black") +
  facet_wrap(~ Time, scales = "free_y") +
  scale_fill_brewer(palette = "Set2") +
  theme_classic(base_size = 15, base_family = "Arial") +
  labs(
    title = "Bh cell concentration under concentrations of Lawsone",
    x = "Concentration",
    y = expression(paste("Cell counts (events ", mu, "L"^{-1}, ")")),
    fill = "Concentration"
  ) +
  theme(
    axis.text.x = element_text(angle = 40, hjust = 1),
    legend.position = "none",
    plot.margin = margin(t = 2, r = 2, b = 2, l = 2),  # tight margin, in pt
    plot.title = element_text(size = 18, margin = margin(b = 4))  # less space under title
  ) +
  geom_segment(data = contrast_df, aes(x = 1, xend = n_conc, y = y, yend = y),
               inherit.aes = FALSE, color = "black") +
  geom_text(data = contrast_df, aes(x = (1 + n_conc)/2, y = y * 1.08, label = label),
            inherit.aes = FALSE, size = 3)

print(violin_pvalue_plot)

ggsave(
  file.path(OUTPUT_DIR, "BH_G2_MK_violin_pvalue_plot.jpg"),
  plot = violin_pvalue_plot,
  width = 10, height = 4.5,   
  dpi = 300
)
```

