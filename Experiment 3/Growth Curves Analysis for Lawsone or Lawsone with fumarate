```{r}

INPUT_FILE <- "BH_G2_MK.xlsx"
SHEET_NAME <- 1   

# Which blank subtracts which samples
# Group "F" (rich medium / YCFAG) is blanked with Blank_YCFAG.
# Every other group (A, B, D, E -> Law, LawF, MKs, Control_A, Control_B) is
# blanked with Blank_ABCD ("Blank_WC4_VM").
RICH_MED_GROUP <- "F"

FIGURE_SETS <- list(
  "Bh growth dynamics under different concentrations of Lawsone"   = c("Law_10", "Law_5", "Law_2.5", "Law_0.625", "Control_Law"),
  "Bh growth dynamics under different concentrations of Lawsone with fumarate"  = c("LawF_10", "LawF_5", "LawF_2.5", "LawF_0.625", "Control_LawF"),
  "Bh growth dynamics under different concentrations of Menaquinone-7"    = c("MK_5", "MK_2.5", "MK_1.25", "MK_0.625", "Control_MK"),
  "Bh growth dynamics under different concentrations of Menaquinone-7 with fumarate"   = c("MKF_5","MKF_2.5", "MKF_1.25", "MKF_0.625", "Control_MKF"),  
  "YCFAG" = c("YCFAG")
)

# Plot settings
LOESS_SPAN       <- 0.25       
ERRORBAR_SD_MULT <- 0.75       
X_BREAKS_BY      <- 6          
X_LIMITS         <- c(0, 48)   
Y_LIMITS         <- NULL      
PALETTE          <- "ggthemes::Superfishel_Stone"
DPI              <- 450
OUTPUT_DIR       <- "BH_Growth_Curves_Experiment3"
```

```{r}
# READ AND PROCESS DATA

parse_time <- function(x) {
  x <- trimws(x)
  m <- regmatches(x, regexec("(\\d+)\\s*h\\s*(?:(\\d+)\\s*min)?", x))
  sapply(m, function(match) {
    if (length(match) == 0) return(NA_real_)
    h <- as.numeric(match[2])
    mins <- ifelse(match[3] == "" | is.na(match[3]), 0, as.numeric(match[3]))
    h + mins / 60
  })
}

raw <- read_excel(INPUT_FILE, sheet = SHEET_NAME, col_names = FALSE)

well_id <- as.character(raw[[1]])[3:nrow(raw)]
content <- as.character(raw[[2]])[3:nrow(raw)]
conc    <- as.character(raw[[3]])[3:nrow(raw)]
group   <- as.character(raw[[4]])[3:nrow(raw)]

time_labels <- as.character(unlist(raw[2, 5:ncol(raw)], use.names = FALSE))
times_h     <- parse_time(time_labels)
n_tp        <- sum(!is.na(times_h))
times_h     <- times_h[1:n_tp]

# Build tidy long-format data
od_long <- map_dfr(seq_along(well_id), function(i) {
  row_idx   <- i + 2 
  od_values <- as.numeric(unlist(raw[row_idx, 5:(4 + n_tp)], use.names = FALSE))
  tibble(
    well    = well_id[i],
    content = content[i],
    conc    = conc[i],
    group   = group[i],
    time_h  = times_h,
    od600   = od_values
  )
})

# Identify blanks and which blank "type" they belong to
od_long <- od_long %>%
  mutate(
    is_blank   = grepl("^Blank", content, ignore.case = TRUE) |
                 grepl("^Blank", conc, ignore.case = TRUE),
    blank_type = case_when(
      is_blank & grepl("YCFAG", conc, ignore.case = TRUE) ~ "YCFAG",
      is_blank                                            ~ "ABCD",
      TRUE                                                ~ NA_character_
    )
  )

# Mean blank OD at each timepoint, per blank type
blank_means <- od_long %>%
  filter(is_blank) %>%
  group_by(blank_type, time_h) %>%
  summarise(blank_od = mean(od600, na.rm = TRUE), .groups = "drop")

# Assign each sample the blank type it should be corrected with:
# rich-medium group (RICH_MED_GROUP) -> YCFAG blank, everything else -> ABCD blank
od_corrected <- od_long %>%
  filter(!is_blank) %>%
  mutate(blank_type = if_else(group == RICH_MED_GROUP, "YCFAG", "ABCD")) %>%
  left_join(blank_means, by = c("blank_type", "time_h")) %>%
  mutate(od_corrected = od600 - blank_od) %>%
  rename(Condition = conc)

# Summary: mean +/- SD per condition per time point
summary_data <- od_corrected %>%
  group_by(Condition, group, time_h) %>%
  summarise(
    Mean_OD600 = mean(od_corrected, na.rm = TRUE),
    SD_OD600   = sd(od_corrected, na.rm = TRUE),
    n_rep      = sum(!is.na(od_corrected)),
    .groups    = "drop"
  ) %>%
  arrange(group, time_h)

cat(sprintf("Data ready: %d conditions, %d time points\n",
            n_distinct(summary_data$Condition), n_tp))
```

