# One comparison figure per figure set entry
# ex: "Law" -> Law_10, Law_5, Law_2.5, Law_0.625, Control_A all on one plot

for (fig_name in names(FIGURE_SETS)) {
  conds <- FIGURE_SETS[[fig_name]]

  missing <- setdiff(conds, unique(summary_data$Condition))
  if (length(missing) > 0) {
    cat(sprintf("Note: '%s' not found in data for figure '%s' — skipping those.\n",
                paste(missing, collapse = ", "), fig_name))
  }

  plot_growth(
    data            = summary_data,
    selected_groups = conds,
    title_text      = fig_name,
    output_file     = paste0("growth_curve_", fig_name, ".jpg")
  )
}
