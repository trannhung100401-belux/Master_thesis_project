#!/bin/bash -l
#SBATCH --clusters=genius
#SBATCH --account=lmsysbio
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --cpus-per-task=20
#SBATCH --time=24:00:00
#SBATCH --job-name=gapseqExp
#SBATCH --array=1-4%4
#SBATCH --output=/data/log/Exp.out
#SBATCH --error=/data/log/Exp.err

set -euo pipefail

STUDY="/data/Exp"
GENOMEDIR="$STUDY/genomes"
SIF="$VSC_SCRATCH/gapseq_project/gapseq_1.4.0.sif"
THREADS="${SLURM_CPUS_PER_TASK:-1}"

mkdir -p "$STUDY/log" "$STUDY/tmp" "$STUDY/out"

MICROBES_LIST="$STUDY/IDgenome_list.tsv"
LINE="$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$MICROBES_LIST" || true)"
MICROBE="$(echo "$LINE" | tr -d '\r' | awk '{print $1}')"

if [[ -z "${MICROBE}" ]]; then
  echo "ERROR: No microbe name found for SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID}"
  echo "Line was: '$LINE'"
  exit 1
fi

GENOME_HOST="$GENOMEDIR/${MICROBE}.fa"
if [[ ! -f "$GENOME_HOST" ]]; then
  echo "ERROR: genome not found: $GENOME_HOST"
  exit 1
fi

OUT="$STUDY/out/$MICROBE"
FIND_DIR="$OUT/find"
DRAFT_DIR="$OUT/draft"
mkdir -p "$FIND_DIR" "$DRAFT_DIR"

# Apptainer cache/temp in SCRATCH to avoid HOME quota
export APPTAINER_CACHEDIR="$VSC_SCRATCH/.apptainer/cache"
export APPTAINER_TMPDIR="$VSC_SCRATCH/.apptainer/tmp"
mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR"

# temp INSIDE container must exist and be writable via bind mount
export TMPDIR="/work/tmp"

echo "==== gapseq Exp run ===="
echo "ARRAY_TASK_ID: $SLURM_ARRAY_TASK_ID"
echo "Microbe      : $MICROBE"
echo "Genome (host): $GENOME_HOST"
echo "Node         : $(hostname)"
echo "Start        : $(date)"
echo "Threads      : $THREADS"
echo "========================"

# Bind entire study to /work so outputs, logs, tmp are writable
BIND="--bind $STUDY:/work:rw"

# Use a stable genome path INSIDE container
GENOME_IN="/work/genomes/${MICROBE}.fa"

# (1) FIND

echo "[1/3] gapseq find ..."
apptainer exec $BIND --pwd "/work/out/$MICROBE/find" "$SIF" \
  gapseq find -p all -b 200 -m auto -t auto -K "$THREADS" -v 2 \
    -f "/work/out/$MICROBE/find" \
    "$GENOME_IN" \
  2>&1 | tee "$STUDY/log/${MICROBE}.find.log"

# ----------------------
# (2) FIND-TRANSPORT
# ----------------------
echo "[2/3] gapseq find-transport ..."
apptainer exec $BIND --pwd "/work/out/$MICROBE/find" "$SIF" \
  gapseq find-transport -b 200 -K "$THREADS" \
    "$GENOME_IN" \
  2>&1 | tee "$STUDY/log/${MICROBE}.findtransport.log"

# ----------------------
# (3) DRAFT
# ----------------------
echo "[3/3] gapseq draft ..."
apptainer exec $BIND --pwd "/work/out/$MICROBE/draft" "$SIF" \
  gapseq draft \
    -r "/work/out/$MICROBE/find/${MICROBE}-all-Reactions.tbl" \
    -p "/work/out/$MICROBE/find/${MICROBE}-all-Pathways.tbl" \
    -t "/work/out/$MICROBE/find/${MICROBE}-Transporter.tbl" \
    -c "$GENOME_IN" \
    -b auto \
    -f "/work/out/$MICROBE/draft" \
  2>&1 | tee "$STUDY/log/${MICROBE}.draft.log"

echo "Done: $(date)"
